# Browser entry point: http://localhost:8088
HTTP_PORT=8088

# Used to initialize the Compose-managed PostgreSQL database.
DB_NAME=proof3161
DB_USERNAME=proof3161

# Required. Set a strong local password in the ignored .env file.
DB_PASSWORD=

# Live timestamp authority.
TSA_URL=https://freetsa.org/tsr

# Host-side path, relative to compose.yaml.
# Provision an independently trusted public CA certificate here.
TSA_ROOT_CERT_FILE=./certificates/tsa-root.pem

# Required only with compose.production.yaml.
# Replace with a public hostname that points directly to the VPS.
PUBLIC_DOMAIN=proof.example.com

# Replace with an email address you monitor.
ACME_EMAIL=admin@example.com